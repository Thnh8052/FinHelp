# Server Configuration
HOST=0.0.0.0
PORT=8000
# "development" only on your own machine: it allows the placeholder SECRET_KEY and logs reset codes when no email is configured
ENVIRONMENT=production
DEBUG=True

# Security & JWT Auth
# Required (the server does not start without it). Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change_this_to_a_very_secure_random_secret_key_in_production
# Password of the `admin` account (at least 8 characters), created / reset to it at startup. Unset: no admin is created and an existing one is left alone.
# Leave the line commented out rather than empty: an empty value fails the 8-character check and the server does not start.
# ADMIN_PASSWORD=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# MongoDB Configuration
# 27018 = the MongoDB container of docker-compose.yml (published on this port so it never clashes with a MongoDB already installed on 27017)
MONGODB_URI=mongodb://127.0.0.1:27018
MONGODB_DB_NAME=datn_finance

# Qdrant Configuration (server from docker compose, or leave QDRANT_PATH empty)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION_NAME=financial_chunks_m3
# Leave QDRANT_API_KEY unset for the local Docker container (any value, even empty, makes the client use HTTPS)
# QDRANT_API_KEY=
# Embedded Qdrant (no Docker for the vector store): set a folder, e.g. ./storage/qdrant
QDRANT_PATH=

# Storage Configuration (local | r2)
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./storage
PDF_STORAGE_DIR=./storage/pdfs
ARTIFACTS_STORAGE_DIR=./storage/artifacts

# Cloudflare R2 / S3 Object Storage (Active when STORAGE_BACKEND=r2)
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=finhelp-storage
R2_PUBLIC_DOMAIN=

# LLM: DeepSeek chat-completions API (query decomposition + answer generation). Without a key the system still
# retrieves and shows the best excerpts, but cannot write answers or sub-queries.
DEEPSEEK_API_KEY=
DEFAULT_LLM_MODEL=deepseek-flash
LLM_BASE_URL=https://api.deepseek.com
GENERATION_PROMPT=v3

# Research core. PARSER_ENGINE: docling (accurate, minutes per filing) | pymupdf (fast, lower table quality)
PARSER_ENGINE=docling
DOCLING_DEVICE=auto
DEFAULT_EMBEDDING_MODEL=BAAI/bge-m3
# fp16 safetensors copy of BGE-M3 (half the RAM while loading); used when model.safetensors is in it, empty = load from the hub
# EMBEDDING_FP16_DIR=storage/models/bge-m3-fp16
EMBEDDING_DIM=1024
RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B
RERANK_ENABLED=True
DEVICE=auto
# auto: both models stay on the GPU until the first out-of-memory, then they take turns (4 GB cards); swap: take turns from the
# start (the idle model is released and reloaded on its next turn); resident: never take turns
GPU_MODE=auto
# Share of GPU memory the models may use (the run command in version_control.md sets 0.8)
# GPU_MEMORY_FRACTION=0.85
SUBQUERY_COUNT=3
RETRIEVAL_POOL_SIZE=20
RETRIEVAL_TOP_K=6

# Models are cached locally after the first download; this skips the online freshness check on every load.
# HF_HUB_OFFLINE=1

# Optional: a GPU worker on another machine (embeddings, reranker, PDF parsing). Unset: the models run in this process.
# REMOTE_GPU_URL=

# Base URL of the web app, used in the link of the password-reset email (the Vite dev server is on 5173)
# FRONTEND_URL=http://localhost:5173

# Email Service (SendGrid)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
