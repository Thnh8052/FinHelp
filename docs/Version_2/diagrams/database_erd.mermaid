%% =========================================================================
%% Lược đồ Cơ sở Dữ liệu Thực thể Liên kết (ERD) - FinHelp V3.1
%% Khớp với docs/Version_2/PILLAR_2_MONGODB_SPECIFICATION.md
%% =========================================================================

erDiagram
  USERS ||--o{ NOTEBOOKS : "sở hữu (owner_type = user)"
  NOTEBOOKS ||--o{ DOCUMENTS : "đính kèm (User <= 5, Guest <= 1)"
  NOTEBOOKS ||--o{ MESSAGES : "luồng hội thoại"
  DOCUMENTS ||--|| INGESTION_JOBS : "tiến trình xử lý"
  DOCUMENTS ||--o{ CHUNKS : "phân mảnh ngữ nghĩa"

  USERS {
    string user_id PK "Mã người dùng"
    string email UK "Email, không phân biệt hoa thường"
    string username UK "Tên đăng nhập, không phân biệt hoa thường"
    string hashed_password "Mật khẩu băm Bcrypt"
    string full_name "Họ tên hiển thị"
    string role "user | admin"
    int daily_messages_limit "Hạn mức câu hỏi mỗi ngày"
    int daily_messages_used "Số câu hỏi đã dùng trong ngày"
    datetime daily_window_start "00:00 UTC của ngày đang đếm"
    long total_tokens_consumed "Tổng token AI đã dùng"
    bool is_active "Tài khoản còn hoạt động"
    string reset_token "Mã OTP quên mật khẩu"
    datetime reset_token_expires_at "Hạn của mã OTP"
    datetime last_login_at "Lần đăng nhập cuối"
    datetime created_at "Ngày tạo"
    datetime updated_at "Ngày cập nhật"
  }

  NOTEBOOKS {
    string notebook_id PK "Mã notebook, cũng là mã đoạn chat"
    string owner_type "user | guest | system"
    string owner_id FK "user_id, mã khách hoặc system"
    string title "Tiêu đề đoạn chat"
    object focus_state "active_ticker, fiscal_year, last_metric"
    int message_count "Bộ đếm cấp message_index"
    datetime created_at "Thời điểm tạo"
    datetime updated_at "Lần dùng gần nhất"
  }

  DOCUMENTS {
    string document_id PK "Mã tài liệu"
    string notebook_id FK "Thuộc đoạn chat nào"
    string file_name "Tên tệp PDF gốc"
    int file_size_bytes "Dung lượng tệp"
    string file_path "Object key tương đối"
    string file_hash "SHA-256, unique theo notebook"
    int page_count "Tổng số trang"
    string status "pending | processing | ready | failed"
    string error_message "Lý do lỗi cho người dùng"
    string parsing_engine "docling | pymupdf_fallback"
    object metadata "Danh mục BCTC"
    string catalog_confirmed_by "Người xác nhận danh mục"
    datetime catalog_confirmed_at "Thời điểm xác nhận"
    datetime created_at "Thời điểm tải lên"
    datetime updated_at "Thời điểm cập nhật"
  }

  INGESTION_JOBS {
    string job_id PK "Mã tiến trình"
    string document_id UK "1:1 với tài liệu"
    string notebook_id FK "Thuộc đoạn chat nào"
    string worker_id "Máy đang xử lý"
    string status "pending | processing | completed | failed"
    string stage "docling | chunking | embedding | indexing"
    int progress_percent "0 đến 100"
    object timings "Số giây từng bước"
    int extracted_chunks_count "Số chunk tạo ra"
    datetime queued_at "Lúc vào hàng đợi"
    datetime started_at "Lúc bắt đầu chạy"
    datetime finished_at "Lúc kết thúc"
    datetime updated_at "Lần tiến triển gần nhất"
    string error_log "Chi tiết kỹ thuật khi lỗi"
  }

  CHUNKS {
    string chunk_id PK "Mã đoạn, nối với vector Qdrant"
    string notebook_id FK "Thuộc đoạn chat nào"
    string document_id FK "Thuộc tài liệu nào"
    int chunk_index "Thứ tự trong tài liệu"
    int page "Số trang PDF gốc"
    string section "Tiêu đề mục"
    string chunk_type "table | text"
    string text_type "financial_statement | narrative"
    string content "Văn bản hoặc bảng Markdown"
    int token_count "Số token"
    object sparse_weights "Trọng số từ khoá BGE-M3"
    list flags "Dấu hiệu prompt injection"
    object table_metadata "Tiêu đề và đơn vị bảng"
    string embedding_model "Model đã nhúng"
    datetime created_at "Ngày tạo"
  }

  MESSAGES {
    string message_id PK "Mã tin nhắn"
    string notebook_id FK "Thuộc đoạn chat nào"
    int message_index "Thứ tự trong đoạn chat"
    string role "user | assistant | system"
    string content "Nội dung Markdown"
    list citations "Trích dẫn: document_id, page, snippet"
    object trace_info "Kế hoạch tìm kiếm, kiểm chứng, timings"
    object token_usage "prompt, completion, total tokens"
    int latency_ms "Thời gian trả lời"
    string model_used "Model sinh câu trả lời"
    int user_rating "+1 hoặc -1"
    datetime created_at "Thời điểm gửi"
  }
